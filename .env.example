# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소에 올라가지 않는다.
#
# 예전 이 파일은 쓰지도 않는 Postgres 키(DB_HOST·DB_PORT=5432 등)를 담고 있어서,
# 그대로 복사하면 정작 필요한 MONGO_URI 가 빠진 .env 가 만들어졌다.
# 실제로 코드가 읽는 값은 아래 넷이 전부다.

# MongoDB 접속 주소. 없으면 서버는 뜨지만 DB 의존 기능이 전부 실패한다
# (/본캐 · /건의 · /레벨히스토리 · /보스).
#
# 로컬 개발:  brew services start mongodb-community
#            운영과 다른 DB 이름을 써서 실수로 운영 데이터를 건드리지 않게 한다.
MONGO_URI=mongodb://127.0.0.1:27017/gsbot_dev

# Nexon OpenAPI 키 (https://openapi.nexon.com 에서 발급)
# 캐릭터 조회 계열이 전부 이 키를 쓴다.
API_KEY=your_nexon_open_api_key

PORT=3000
NODE_ENV=development
